package jpamb.cases;

import java.util.HashSet;
import java.util.Set;
import jpamb.utils.*;

// Internal dev suite. Every testable method has a ground-truth line:
//   GT: vulnerable | safe   (can any input reach canary()?)
public class VulnerableDev {

    // ---------------------------------------------------------
    // SINK
    // ---------------------------------------------------------

    public static void canary() {
        throw new AssertionError("Vulnerability Reached: Canary Loaded!");
    }

    // ---------------------------------------------------------
    // MOCK DESERIALIZATION
    // Payload format: serialized_<ClassName>[_legacy]
    // The Python interpreter intercepts these two methods and decodes the
    // string itself; the Java bodies keep the JVM ground truth identical.
    // ---------------------------------------------------------

    private static final String PREFIX = "serialized_";
    private static final String LEGACY_FLAG = "_legacy";

    public static String simulateResolveClassName(String payload) throws Exception {
        if (!payload.startsWith(PREFIX)) {
            throw new IllegalArgumentException("Malformed payload");
        }
        String name = payload.substring(PREFIX.length());
        if (name.endsWith(LEGACY_FLAG)) {
            name = name.substring(0, name.length() - LEGACY_FLAG.length());
        }
        return name;
    }

    public static Object simulateReadObject(String payload) throws Exception {
        String name = simulateResolveClassName(payload);
        int legacy = payload.endsWith(LEGACY_FLAG) ? 1 : 0;

        if (name.equals("DummyButton")) return new DummyButton();
        if (name.equals("SafeCommand")) return new SafeCommand();
        if (name.equals("__CANARY__Command")) return new __CANARY__Command();
        if (name.equals("UpdatedLibrary")) return new UpdatedLibrary();
        if (name.equals("DownGradableLibrary")) return new DownGradableLibrary(legacy);
        throw new ClassNotFoundException(name);
    }

    // ---------------------------------------------------------
    // CLASSES (GADGET CHAINS AND SINKS)
    // ---------------------------------------------------------

    public static class __CANARY__Command {
        public __CANARY__Command() {
            canary();
        }
    }

    public static class SafeCommand {
        public void doAction() {
            System.out.println("This is a safe method. Doing normal work.");
        }
    }

    // The implicit super() call reaches the sink.
    public static class SafeWrapperCommand extends __CANARY__Command {}

    public static class DummyButton {
        public DummyButton() {}
    }

    public static class NotMaintainedDependency {
        public NotMaintainedDependency() {
            new __CANARY__Command();
        }
    }

    public static class UpdatedLibrary {
        public UpdatedLibrary() {
            new NotMaintainedDependency();
        }
    }

    public static class DownGradableLibrary {
        private int legacy = 0;
        public DownGradableLibrary(int legacy) {
            this.legacy = legacy;
            if (legacy == 1) {
                new NotMaintainedDependency();
            }
        }
    }

    // Virtual dispatch: only LoadAction loads classes from the input.
    // DeadAction is never instantiated (spurious edge for a CHA call graph).
    public interface Action {
        void run(String s);
    }

    public static class LogAction implements Action {
        public void run(String s) {
            System.out.println("Logged: " + s);
        }
    }

    public static class LoadAction implements Action {
        public void run(String s) {
            try {
                Class<?> cmdClass = Class.forName("jpamb.cases.VulnerableDev$" + s + "Command");
                SafeCommand ao = (SafeCommand) cmdClass.newInstance();
                ao.doAction();
            } catch (Exception e) {
                System.out.println("Safe exception handling.");
            }
        }
    }

    public static class DeadAction implements Action {
        public void run(String s) {
            new __CANARY__Command();
        }
    }

