        String name = "";
        for (int i = 0; i < ctl.length(); i++) {
            name = name + ctl.charAt(i);
        }

        String className = "jpamb.cases.VulnerableDev$" + name + "Command";

        try {
            Class<?> cmdClass = Class.forName(className);
            SafeCommand ao = (SafeCommand) cmdClass.newInstance();
