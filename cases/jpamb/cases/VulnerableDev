    // =========================================================
    // CWE-502: Deserialization of Untrusted Data
    // =========================================================

    // GT: vulnerable (no check)
    @Case("(s'serialized_DummyButton') -> ok")
    @Case("(s'serialized_SafeCommand') -> ok")
    @Case("(s'serialized___CANARY__Command') -> assertion error")
    public static void insecure_deserialization(String serializedPayload) {
        try {
            Object deserializedObj = simulateReadObject(serializedPayload);

            DummyButton button = (DummyButton) deserializedObj;

        } catch (Exception e) {
            System.out.println("Safe exception handling");
        }
    }

    // GT: vulnerable (blacklist misses the gadget chain)
    @Case("(s'serialized_DummyButton') -> ok")
    @Case("(s'serialized___CANARY__Command') -> ok")
    @Case("(s'serialized_UpdatedLibrary') -> assertion error")
    public static void blacklist_deserialization(String serializedPayload) {
        try {
            String[] blacklist = new String[] { "__CANARY__Command", "SafeWrapperCommand" };
            String className = simulateResolveClassName(serializedPayload);
            for (String blacklisted : blacklist) {
                if (className.contains(blacklisted)) {
                    System.out.println("Access denied: blacklisted class detected.");
                    return;
                }
            }
            Object deserializedObj = simulateReadObject(serializedPayload);

            DummyButton button = (DummyButton) deserializedObj;

        } catch (Exception e) {
            System.out.println("Safe exception handling");
        }
    }

    // GT: vulnerable (whitelist on class name only; the legacy flag is not checked)
    @Case("(s'serialized___CANARY__Command') -> ok")
    @Case("(s'serialized_DownGradableLibrary') -> ok")
    @Case("(s'serialized_DownGradableLibrary_legacy') -> assertion error")
    public static void whitelist_deserialization(String serializedPayload) {
        try {
            String[] whitelist = new String[] { "DownGradableLibrary" };
            String className = simulateResolveClassName(serializedPayload);
            boolean allowed = false;
            for (String whitelisted : whitelist) {
                if (className.equals(whitelisted)) {
                    allowed = true;
                }
            }
            if (!allowed) {
                System.out.println("Access denied: class not in whitelist.");
                return;
            }
            Object deserializedObj = simulateReadObject(serializedPayload);

            DownGradableLibrary library = (DownGradableLibrary) deserializedObj;

        } catch (Exception e) {
            System.out.println("Safe exception handling");
        }
    }

