    // GT: vulnerable (taint through recursion: needs a fixpoint)
    @Case("(s'Safe') -> ok")
    @Case("(s'__CANARY__') -> assertion error")
    public static void recursive_builder_dispatcher(String ctl) {
        String className = "jpamb.cases.VulnerableDev$" + copy(ctl, 0) + "Command";

        try {
            Class<?> cmdClass = Class.forName(className);
            SafeCommand ao = (SafeCommand) cmdClass.newInstance();
            ao.doAction();
        } catch (Exception e) {
            System.out.println("Safe exception handling.");
        }
    }

    private static String copy(String s, int i) {
        if (i >= s.length()) {
            return "";
        }
        return s.charAt(i) + copy(s, i + 1);
    }

