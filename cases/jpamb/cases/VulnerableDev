    // GT: safe (class is loaded but never instantiated)
    @Case("(s'Safe') -> ok")
    @Case("(s'__CANARY__') -> ok")
    @Case("(s'SafeWrapper') -> ok")
    public static void no_init_loader(String ctl) {
        String className = "jpamb.cases.VulnerableDev$" + ctl + "Command";

        try {
            Class<?> cmdClass = Class.forName(className, false, ClassLoader.getSystemClassLoader());
            if (SafeCommand.class.isAssignableFrom(cmdClass)) {
                System.out.println("Assignable to SafeCommand.");
            } else {
                System.out.println("Not assignable to SafeCommand.");
            }
        } catch (Exception e) {
            System.out.println("Safe exception handling.");
        }
    }

    // GT: vulnerable (only LoadAction reaches the sink; DeadAction is never created)
    @Case("(s'__CANARY__', 0) -> ok")
    @Case("(s'__CANARY__', 1) -> assertion error")
    @Case("(s'Safe', 1) -> ok")
    public static void virtual_dispatcher(String ctl, int kind) {
        Action action;
        if (kind == 1) {
            action = new LoadAction();
        } else {
            action = new LogAction();
        }
        action.run(ctl);
    }

    // ---------------------------------------------------------
    // Taint: interprocedural, parameters, fixpoint
    // ---------------------------------------------------------

    // GT: vulnerable (taint through parameters and return values, 3 methods)
    @Case("(s'Safe') -> ok")
    @Case("(s'__CANARY__') -> assertion error")
    public static void interprocedural_dispatcher(String ctl) {
        String className = build(ctl);
        load(className);
    }

    private static String qualify(String simple) {
        return "jpamb.cases.VulnerableDev$" + simple;
    }

    private static String build(String ctl) {
        return qualify(ctl) + "Command";
    }

    private static void load(String className) {
        try {
            Class<?> cmdClass = Class.forName(className);
            SafeCommand ao = (SafeCommand) cmdClass.newInstance();
            ao.doAction();
        } catch (Exception e) {
            System.out.println("Safe exception handling.");
        }
    }

