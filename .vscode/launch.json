{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug JPAMB Interpreter",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/jpamb",
            "args": [
                "-vv",
                "interpret",
                "--filter",
                "Vulnerable",
                "--step-wise",
                "dynamic-interpreter"
            ],
            "console": "integratedTerminal",
            "subProcess": true,
            "justMyCode": false
        }
    ]
}